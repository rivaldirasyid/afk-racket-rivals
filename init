    local code = string.format('task.wait(3) loadstring(game:HttpGet("%s"))()', CONFIG.SCRIPT_URL)
    pcall(function() if queue_on_teleport then queue_on_teleport(code) end end)
end

-- Fungsi Stagger untuk Multi-Account
local function doStaggerWait(maxDelay, label)
    local delay = player.UserId % (maxDelay + 1)
    if delay > 0 then
        log(string.format("Stagger Delay (%s): Menunggu %d detik...", label, delay))
        task.wait(delay)
    end
end

local function teleportTo(placeId, label)
    log(string.format("Teleport ke %d (%s)...", placeId, label))
    local methods = {
        { name = "Teleport", fn = function() TeleportService:Teleport(placeId, player) end },
        { name = "TeleportAsync", fn = function()
            if TeleportService.TeleportAsync then TeleportService:TeleportAsync(placeId, {player})
            else error("no TeleportAsync") end
        end },
    }
    local attempt = 0
    for _, method in ipairs(methods) do
        for _, delay in ipairs(CONFIG.RETRY_DELAYS) do
            attempt = attempt + 1
            local ok = pcall(method.fn)
            log(string.format("  [%d] %s -> %s", attempt, method.name, tostring(ok)))
            if ok then return true end
            if attempt < #methods * #CONFIG.RETRY_DELAYS then task.wait(delay) end
        end
    end
    return false
end

-- =====================================================
-- UI DETECTION
-- =====================================================
local function isRewardCollected()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return false, "No PlayerGui" end
    
    local current = pg
    for segment in CONFIG.UI_PATH:gmatch("[^%.]+") do
        current = current:FindFirstChild(segment)
        if not current then return false, "Path not found" end
    end
    
    if not (current:IsA("TextLabel") or current:IsA("TextBox")) then
        return false, "Invalid UI Type"
    end
    
    local txt = current.Text:lower()
    if txt:find("collected") then return true, current.Text end
    return false, current.Text
end

