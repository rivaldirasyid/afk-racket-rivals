-- =====================================================
-- File helpers (safe, cek dukungan executor)
-- =====================================================
local FILE_IO = (writefile and readfile and isfile)

local function writeSafe(path, content)
    if not FILE_IO then return false end
    local ok = pcall(writefile, path, content)
    return ok
end

local function readSafe(path)
    if not FILE_IO then return nil end
    local ok, exists = pcall(isfile, path)
    if not ok or not exists then return nil end
    local ok2, content = pcall(readfile, path)
    if ok2 then return content end
    return nil
end

-- =====================================================
-- State management
-- =====================================================
local function loadEnabled()
    if getgenv().AutoAFK_Loaded then return getgenv().AutoAFK_Enabled end
    local state = true
    local content = readSafe(CONFIG.FILE_ENABLED)
    if content then
        state = (content:lower():find("on") ~= nil)
        log("Enabled state dari file:", state and "ON" or "OFF")
    else
        log("Enabled state: default ON (file belum ada)")
    end
    getgenv().AutoAFK_Enabled = state
    getgenv().AutoAFK_Loaded = true
    return state
end

local function saveEnabled(state)
    getgenv().AutoAFK_Enabled = state
    writeSafe(CONFIG.FILE_ENABLED, state and "on" or "off")
end

local function saveSession(mode, startTime)
    local t = startTime or os.time()
    writeSafe(CONFIG.FILE_SESSION, string.format("%s|%d", mode, t))
    log("Session disimpan:", mode, "| started:", os.date("%H:%M:%S", t))
end

local function loadSession()
    local content = readSafe(CONFIG.FILE_SESSION)
    if not content then return nil end
    local mode, ts = content:match("^([^|]+)|(%d+)$")
    if not mode or not ts then return nil end
    return mode, tonumber(ts)
end

local function clearSession()
    writeSafe(CONFIG.FILE_SESSION, "")
end

local function writeHeartbeat()
    writeSafe(CONFIG.FILE_HEARTBEAT, tostring(os.time()))
end

local function readHeartbeat()
    local content = readSafe(CONFIG.FILE_HEARTBEAT)
    if not content then return nil end
    return tonumber(content)
end

getgenv().AutoAFK_Session = (getgenv().AutoAFK_Session or 0)

-- =====================================================
-- ANTI-IDLE MAKSIMAL (HYBRID 3-LAPIS)
-- =====================================================
local lastAntiIdle = 0

local function performAntiIdle(reason)
    if tick() - lastAntiIdle < CONFIG.ANTI_IDLE_THROTTLE then return end
    lastAntiIdle = tick()

    local success = false

    -- Lapisan 1: VirtualUser ClickButton2 (standar)
    success = pcall(function()
        VU:CaptureController()
        VU:ClickButton2(Vector2.new(0, 0))
    end)

    -- Lapisan 2: Fallback ClickButton1
    if not success then
        success = pcall(function()
            VU:CaptureController()
            VU:ClickButton1(Vector2.new(0, 0))
        end)
    end

    -- Lapisan 3: Fallback Button1Down/Up
    if not success then
        success = pcall(function()
            VU:CaptureController()
            VU:Button1Down(Vector2.new(0, 0))
            task.wait(0.03)
            VU:Button1Up(Vector2.new(0, 0))
        end)
    end

    if CONFIG.DEBUG then
        log(string.format("[AntiIdle] %s | success: %s", reason, tostring(success)))
    end
end

