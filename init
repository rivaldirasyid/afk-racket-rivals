-- =====================================================
-- MULTI-ACCOUNT FILE ISOLATION
-- =====================================================
local userSuffix = "_" .. tostring(player.UserId)
CONFIG.FILE_ENABLED   = CONFIG.FILE_ENABLED .. userSuffix .. ".txt"
CONFIG.FILE_SESSION   = CONFIG.FILE_SESSION .. userSuffix .. ".txt"
CONFIG.FILE_HEARTBEAT = CONFIG.FILE_HEARTBEAT .. userSuffix .. ".txt"
CONFIG.FILE_STATS     = CONFIG.FILE_STATS .. userSuffix .. ".txt"
CONFIG.FILE_LOG       = CONFIG.FILE_LOG .. userSuffix .. ".txt"

local FILE_IO = (writefile and readfile and isfile)
local CAN_APPEND = (type(appendfile) == "function")

local function writeSafe(path, content)
    if not FILE_IO then return false end
    return pcall(writefile, path, content)
end

local function readSafe(path)
    if not FILE_IO then return nil end
    local ok, exists = pcall(isfile, path)
    if not ok or not exists then return nil end
    local ok2, content = pcall(readfile, path)
    return ok2 and content or nil
end

-- =====================================================
-- LOG (fast append, with rotation fallback)
-- =====================================================
local logLineCount = 0
local function log(...)
    local msg = table.concat({...}, " ")
    if CONFIG.DEBUG then print("[AutoAFK]", msg) end
    if not FILE_IO then return end

    local line = os.date("[%H:%M:%S] ") .. msg .. "\n"
    logLineCount = logLineCount + 1

    if CAN_APPEND then
        pcall(appendfile, CONFIG.FILE_LOG, line)
        -- Rotate every 500 lines to keep file manageable
        if logLineCount % 500 == 0 then
            local existing = readSafe(CONFIG.FILE_LOG)
            if existing and #existing > 200000 then
                writeSafe(CONFIG.FILE_LOG, "[Log Rotated]\n" .. line)
            end
        end
    else
        local existing = readSafe(CONFIG.FILE_LOG) or ""
        if #existing > 100000 then existing = "[Log Rotated]\n" end
        writeSafe(CONFIG.FILE_LOG, existing .. line)
    end
end

-- =====================================================
-- STATISTIK
-- =====================================================
local Stats = { sessions = 0, runtime = 0, yen = 0 }

local function loadStats()
    local data = readSafe(CONFIG.FILE_STATS)
    if data and data ~= "" then
        local s, r, y = data:match("^(%d+)|(%d+)|(%d+)$")
        if s and r and y then
            Stats.sessions = tonumber(s) or 0
            Stats.runtime  = tonumber(r) or 0
            Stats.yen      = tonumber(y) or 0
        end
    end
    log(string.format("Stats loaded: Sesi=%d, Runtime=%dh, Yen=%d",
        Stats.sessions, math.floor(Stats.runtime / 3600), Stats.yen))
end

local function saveStats()
    writeSafe(CONFIG.FILE_STATS, string.format("%d|%d|%d",
        Stats.sessions, Stats.runtime, Stats.yen))
end

local function addStatsSession(yenEarned, seconds)
    Stats.sessions = Stats.sessions + 1
    Stats.yen = Stats.yen + (yenEarned or 0)
    Stats.runtime = Stats.runtime + (seconds or 0)
    saveStats()
end

-- =====================================================
-- STATE
-- =====================================================
local function loadEnabled()
    if getgenv().AutoAFK_Loaded then return getgenv().AutoAFK_Enabled end
    local state = true
    local content = readSafe(CONFIG.FILE_ENABLED)
    if content then state = (content:lower():find("on") ~= nil) end
    getgenv().AutoAFK_Enabled = state
    getgenv().AutoAFK_Loaded = true
    return state
end

local function saveEnabled(state)
    getgenv().AutoAFK_Enabled = state
    writeSafe(CONFIG.FILE_ENABLED, state and "on" or "off")
end

local function saveSession(mode, startTime)
    local t = startTime or os.time()
    writeSafe(CONFIG.FILE_SESSION, string.format("%s|%d", mode, t))
    getgenv().AutoAFK_SessionData = { mode = mode, startTime = t }
    log(string.format("Session [%s] disimpan (start=%s)", mode, os.date("%H:%M:%S", t)))
end

local function loadSession()
    local backup = getgenv().AutoAFK_SessionData
    if backup and backup.mode and backup.startTime then
        return backup.mode, backup.startTime, "getgenv"
    end
    local content = readSafe(CONFIG.FILE_SESSION)
    if content and content ~= "" then
        local mode, ts = content:match("^([^|]+)|(%d+)$")
        if mode and ts then return mode, tonumber(ts), "file" end
    end
    return nil
end

local function clearSession()
    writeSafe(CONFIG.FILE_SESSION, "")
    getgenv().AutoAFK_SessionData = nil
end

