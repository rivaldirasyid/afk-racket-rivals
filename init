-- =====================================================
-- Recovery logic saat startup
-- =====================================================
local function detectRecovery()
    local lastHeartbeat = readHeartbeat()
    if not lastHeartbeat then return false, nil end
    local gap = os.time() - lastHeartbeat
    log(string.format("Heartbeat terakhir: %ds lalu", gap))
    if gap > CONFIG.MAX_HEARTBEAT_GAP and gap < CONFIG.RECONNECT_WINDOW then
        return true, string.format("Reconnect setelah %ds", gap)
    end
    return false, nil
end

-- =====================================================
-- Keybind fallback
-- =====================================================
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == CONFIG.KEYBIND then
        log("Keybind " .. CONFIG.KEYBIND.Name .. " ditekan")
        local newState = not getgenv().AutoAFK_Enabled
        saveEnabled(newState)
        log("Toggle via keybind →", newState and "ON" or "OFF")
        if newState and game.PlaceId == CONFIG.PLACE_LOBBY then
            task.spawn(function()
                task.wait(CONFIG.GRACE_DELAY)
                if getgenv().AutoAFK_Enabled then
                    teleportTo(CONFIG.PLACE_AFK, "masuk AFK (keybind)")
                end
            end)
        elseif not newState and game.PlaceId == CONFIG.PLACE_AFK then
            task.spawn(function()
                task.wait(0.5)
                teleportTo(CONFIG.PLACE_LOBBY, "balik (keybind)")
            end)
        end
    end
end)

