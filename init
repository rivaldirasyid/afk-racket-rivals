local function disconnectUIConnections()
    for _, connection in ipairs(Runtime.uiConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(Runtime.uiConnections)
end

local function destroyUI()
    disconnectUIConnections()
    if Runtime.ui then
        pcall(function() Runtime.ui.destroy() end)
        Runtime.ui = nil
    end

    local pg = player:FindFirstChildOfClass("PlayerGui")
    if pg then
        local old = pg:FindFirstChild("AutoAFK_UI")
