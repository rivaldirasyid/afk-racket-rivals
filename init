-- =====================================================
-- AUTO AFK — RACKET RIVALS (v9 + TOGGLE + PERSIST)
-- =====================================================
local CONFIG = {
    PLACE_LOBBY  = 90906407195271,
    PLACE_AFK    = 82492382424045,
    AFK_DURATION = 32 * 60,
    SCRIPT_URL   = "https://raw.githubusercontent.com/rivaldirasyid/afk-racket-rivals/refs/heads/main/init",
    DEBUG        = true,
    UI_ENABLED   = true,
    STATE_FILE   = "AutoAFK_racket_state.txt",
    GRACE_DELAY  = 5,   -- detik sebelum teleport dari Lobby (bisa dibatalkan toggle)
}

local Players         = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local UIS             = game:GetService("UserInputService")
local VU              = game:GetService("VirtualUser")
local player          = Players.LocalPlayer

local function log(...) if CONFIG.DEBUG then print("[AutoAFK]", ...) end end

-- =====================================================
-- State persistence (file, fallback ke getgenv)
-- =====================================================
local function loadEnabled()
    if getgenv().AutoAFK_Loaded then return getgenv().AutoAFK_Enabled end
    local state = true
    if readfile and isfile then
        local ok, exists = pcall(isfile, CONFIG.STATE_FILE)
        if ok and exists then
            local ok2, content = pcall(readfile, CONFIG.STATE_FILE)
            if ok2 and content then
                state = (content:lower():find("on") ~= nil)
                log("State dari file:", state and "ON" or "OFF")
            end
        end
    else
        log("File IO tidak tersedia — state hanya persist selama session")
    end
    getgenv().AutoAFK_Enabled = state
    getgenv().AutoAFK_Loaded = true
    return state
end

local function saveEnabled(state)
    getgenv().AutoAFK_Enabled = state
    if writefile then pcall(writefile, CONFIG.STATE_FILE, state and "on" or "off") end
end

getgenv().AutoAFK_Session = (getgenv().AutoAFK_Session or 0)

-- Anti-AFK
player.Idled:Connect(function()
    pcall(function() VU:CaptureController(); VU:ClickButton2(Vector2.new()) end)
end)

-- =====================================================
-- Auto-reload
-- =====================================================
local function queueReload()
    if CONFIG.SCRIPT_URL == "" then return end
    local code = string.format('task.wait(3) loadstring(game:HttpGet("%s"))()', CONFIG.SCRIPT_URL)
    pcall(function() if queue_on_teleport then queue_on_teleport(code) end end)
    pcall(function() if syn and syn.queue_on_teleport then syn.queue_on_teleport(code) end end)
end

-- =====================================================
-- Teleport
-- =====================================================
local function teleportTo(placeId, label, retries)
    retries = retries or 3
    log(string.format("Teleport ke %d (%s)...", placeId, label))
    for i = 1, retries do
        local ok = pcall(function() TeleportService:Teleport(placeId, player) end)
        log(string.format("  Attempt %d → %s", i, tostring(ok)))
        if ok then return true end
        task.wait(3)
    end
    return false
end

-- =====================================================
-- UI
-- =====================================================
local currentUI = nil

local function destroyUI()
    if currentUI then pcall(function() currentUI.destroy() end); currentUI = nil end
end

local function buildUI(opts)
    opts = opts or {}
    destroyUI()
    local pg = player:WaitForChild("PlayerGui")

    local sg = Instance.new("ScreenGui")
    sg.Name = "AutoAFK_UI"; sg.ResetOnSpawn = false
    sg.DisplayOrder = 100; sg.IgnoreGuiInset = true
    sg.Parent = pg

    local height = opts.showTimer and 172 or 52
    local panel = Instance.new("Frame")
    panel.Name = "Panel"
    panel.Size = UDim2.new(0, 300, 0, height)
    panel.Position = UDim2.new(1, -320, 0, 20)
    panel.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    panel.BackgroundTransparency = 0.08
    panel.BorderSizePixel = 0
    panel.Active = true
    panel.Parent = sg
    Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5; stroke.Transparency = 0.25
    stroke.Parent = panel

    -- Header (clickable toggle)
    local header = Instance.new("TextButton")
    header.Name = "Header"
    header.Size = UDim2.new(1, 0, 0, 52)
    header.BackgroundTransparency = 1
    header.Text = ""
    header.AutoButtonColor = false
    header.Parent = panel

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 10, 0, 10)
    dot.Position = UDim2.new(0, 16, 0.5, -5)
    dot.BorderSizePixel = 0
    dot.Parent = header
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(0, 160, 1, 0)
    title.Position = UDim2.new(0, 34, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = "AUTO AFK"
    title.TextColor3 = Color3.fromRGB(240, 240, 250)
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14
    title.Parent = header

    local statusText = Instance.new("TextLabel")
    statusText.Size = UDim2.new(0, 60, 1, 0)
    statusText.Position = UDim2.new(1, -140, 0, 0)
    statusText.BackgroundTransparency = 1
    statusText.Text = ""
    statusText.TextXAlignment = Enum.TextXAlignment.Right
    statusText.Font = Enum.Font.GothamSemibold
    statusText.TextSize = 12
    statusText.Parent = header

    local switch = Instance.new("Frame")
    switch.Size = UDim2.new(0, 48, 0, 24)
    switch.Position = UDim2.new(1, -76, 0.5, -12)
    switch.BorderSizePixel = 0
    switch.Parent = header
    Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 20, 0, 20)
    knob.BorderSizePixel = 0
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Parent = switch
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local function applyVisuals(state)
        local onC, offC = Color3.fromRGB(80, 220, 120), Color3.fromRGB(220, 80, 80)
        dot.BackgroundColor3 = state and onC or offC
        switch.BackgroundColor3 = state and onC or Color3.fromRGB(80, 80, 90)
        knob.Position = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
        stroke.Color = state and onC or offC
        statusText.Text = state and "ON" or "OFF"
        statusText.TextColor3 = state and onC or offC
    end
    applyVisuals(getgenv().AutoAFK_Enabled)

    -- Timer section (AFK only)
    local timerLabel, barFill, subLabel
    local timerStart = opts.startTime or tick()
    local timerDuration = opts.duration or 0

    if opts.showTimer then
        timerLabel = Instance.new("TextLabel")
        timerLabel.Size = UDim2.new(1, -28, 0, 44)
        timerLabel.Position = UDim2.new(0, 14, 0, 54)
        timerLabel.BackgroundTransparency = 1
        timerLabel.Text = "00:00"
        timerLabel.TextColor3 = Color3.fromRGB(255, 220, 80)
        timerLabel.TextXAlignment = Enum.TextXAlignment.Left
        timerLabel.Font = Enum.Font.GothamBlack
        timerLabel.TextSize = 36
        timerLabel.Parent = panel

        local barBg = Instance.new("Frame")
        barBg.Size = UDim2.new(1, -28, 0, 8)
        barBg.Position = UDim2.new(0, 14, 0, 102)
        barBg.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        barBg.BorderSizePixel = 0
        barBg.Parent = panel
        Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

        barFill = Instance.new("Frame")
        barFill.Size = UDim2.new(0, 0, 1, 0)
        barFill.BackgroundColor3 = Color3.fromRGB(255, 200, 60)
        barFill.BorderSizePixel = 0
        barFill.Parent = barBg
        Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

        subLabel = Instance.new("TextLabel")
        subLabel.Size = UDim2.new(1, -28, 0, 16)
        subLabel.Position = UDim2.new(0, 14, 0, 116)
        subLabel.BackgroundTransparency = 1
        subLabel.Text = "Return at --:--:--"
        subLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
        subLabel.TextXAlignment = Enum.TextXAlignment.Left
        subLabel.Font = Enum.Font.Gotham
        subLabel.TextSize = 12
        subLabel.Parent = panel

        local info = Instance.new("TextLabel")
        info.Size = UDim2.new(1, -28, 0, 14)
        info.Position = UDim2.new(0, 14, 0, 134)
        info.BackgroundTransparency = 1
        info.Text = string.format("PlaceId: %d → %s", game.PlaceId, opts.destinationLabel or "Lobby")
        info.TextColor3 = Color3.fromRGB(150, 150, 170)
        info.TextXAlignment = Enum.TextXAlignment.Left
        info.Font = Enum.Font.Gotham
        info.TextSize = 11
        info.Parent = panel

        local session = Instance.new("TextLabel")
        session.Size = UDim2.new(1, -28, 0, 12)
        session.Position = UDim2.new(0, 14, 0, 150)
        session.BackgroundTransparency = 1
        session.Text = string.format("Session #%d", getgenv().AutoAFK_Session)
        session.TextColor3 = Color3.fromRGB(130, 130, 150)
        session.TextXAlignment = Enum.TextXAlignment.Left
        session.Font = Enum.Font.Gotham
        session.TextSize = 10
        session.Parent = panel
    end

    local function update()
        if not opts.showTimer then return end
        local elapsed = tick() - timerStart
        local remaining = math.max(0, timerDuration - elapsed)
        timerLabel.Text = string.format("%02d:%02d",
            math.floor(remaining / 60), math.floor(remaining % 60))
        local pct = math.clamp(elapsed / timerDuration, 0, 1)
        barFill.Size = UDim2.new(pct, 0, 1, 0)
        local returnAt = os.time() + math.floor(remaining)
        subLabel.Text = string.format("Return at %s  •  %d%%",
            os.date("%H:%M:%S", returnAt), math.floor(pct * 100))
    end
    if opts.showTimer then update() end

    -- Drag
    local dragging, dragStart, startPos
    panel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = panel.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                      or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                       startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)

    -- Toggle handler
    local toggling = false
    local function onToggle()
        if toggling then return end
        toggling = true
        local newState = not getgenv().AutoAFK_Enabled
        log("Toggle →", newState and "ON" or "OFF")
        saveEnabled(newState)
        applyVisuals(newState)

        if not newState then
            if game.PlaceId == CONFIG.PLACE_AFK then
                log("OFF di AFK → balik ke Lobby")
                task.spawn(function()
                    task.wait(0.3)
                    teleportTo(CONFIG.PLACE_LOBBY, "balik (toggle OFF)")
                end)
            end
        else
            if game.PlaceId == CONFIG.PLACE_LOBBY then
                log("ON di Lobby → ke AFK dalam " .. CONFIG.GRACE_DELAY .. "s")
                task.spawn(function()
                    local t0 = tick()
                    while (tick() - t0) < CONFIG.GRACE_DELAY do
                        task.wait(0.2)
                        if not getgenv().AutoAFK_Enabled then
                            log("Dibatalkan"); return
                        end
                    end
                    teleportTo(CONFIG.PLACE_AFK, "masuk AFK")
                end)
            end
        end
        task.wait(0.3); toggling = false
    end

    header.MouseButton1Click:Connect(onToggle)
    header.Activated:Connect(onToggle)

    currentUI = {
        destroy = function() sg:Destroy() end,
        update = update,
    }
    return currentUI
end

-- =====================================================
-- MAIN
-- =====================================================
log("=== AUTO AFK START | PlaceId:", game.PlaceId, "===")
loadEnabled()
log("State:", getgenv().AutoAFK_Enabled and "ON" or "OFF")
queueReload()

-- Bangun UI sesuai posisi
if game.PlaceId == CONFIG.PLACE_LOBBY then
    buildUI({ showTimer = false })
elseif game.PlaceId == CONFIG.PLACE_AFK then
    getgenv().AutoAFK_StartTime = tick()
    buildUI({
        showTimer = true,
        duration = CONFIG.AFK_DURATION,
        startTime = getgenv().AutoAFK_StartTime,
        destinationLabel = "Lobby",
    })
end

if not getgenv().AutoAFK_Enabled then
    log("State OFF — script idle. Toggle ON lewat UI kalau mau mulai.")
    return
end

if game.PlaceId == CONFIG.PLACE_LOBBY then
    log("Mode: LOBBY → AFK (" .. CONFIG.GRACE_DELAY .. "s grace)")
    getgenv().AutoAFK_Session = getgenv().AutoAFK_Session + 1
    local t0 = tick()
    while (tick() - t0) < CONFIG.GRACE_DELAY do
        task.wait(0.2)
        if not getgenv().AutoAFK_Enabled then
            log("Dibatalkan oleh toggle OFF."); return
        end
    end
    if not teleportTo(CONFIG.PLACE_AFK, "masuk AFK") then
        log("Gagal teleport.")
    end

elseif game.PlaceId == CONFIG.PLACE_AFK then
    log(string.format("AFK ROOM — tunggu %d menit...", CONFIG.AFK_DURATION / 60))
    local t0 = getgenv().AutoAFK_StartTime
    while (tick() - t0) < CONFIG.AFK_DURATION do
        task.wait(0.5)
        if not getgenv().AutoAFK_Enabled then
            log("Toggled OFF → toggle handler teleport balik")
            return
        end
        if currentUI and currentUI.update then pcall(currentUI.update) end
    end
    log("Waktu habis → balik ke Lobby")
    if not teleportTo(CONFIG.PLACE_LOBBY, "balik ke Lobby") then
        log("Gagal balik.")
    end
end
