-- =====================================================
local CONFIG = {
    PLACE_LOBBY  = 90906407195271,
    PLACE_AFK    = 82492382424045,
    
    -- Path UI yang ditemukan
    UI_PATH = "PAGES.AfkLobbyPage.Content.Body.Earnings.TimerCard.GuaranteeStrip.Body.Note",
    
    -- Jeda aman setelah teks "collected" muncul (dalam detik)
    SAFE_BUFFER = 2 * 60, 
    
    -- Fallback timer absolut (jika UI gagal dibaca sama sekali)
    -- 30 menit (target) + 2 menit (buffer) + 2 menit (safety) = 34 menit
    FALLBACK_DURATION = 34 * 60, 
    
    SCRIPT_URL   = "https://raw.githubusercontent.com/rivaldirasyid/afk-racket-rivals/refs/heads/main/init",
    DEBUG        = true,
    UI_ENABLED   = true,

    -- Files
    FILE_ENABLED   = "AutoAFK_racket_state.txt",
    FILE_SESSION   = "AutoAFK_session.txt",
    FILE_HEARTBEAT = "AutoAFK_heartbeat.txt",

    -- Timing
    GRACE_DELAY     = 5,
    HEARTBEAT_EVERY = 10,
    POLL_RATE       = 1,

    -- Anti-idle
    ANTI_IDLE_INTERVAL = 55,
    ANTI_IDLE_THROTTLE = 1,
    ANTI_IDLE_WARMUP   = 10,

    KEYBIND = Enum.KeyCode.RightShift,
}

local Players         = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local UIS             = game:GetService("UserInputService")
local VU              = game:GetService("VirtualUser")
local player          = Players.LocalPlayer

local function log(...) if CONFIG.DEBUG then print("[AutoAFK]", ...) end end

-- =====================================================
-- File IO & Persistence
-- =====================================================
local FILE_IO = (writefile and readfile and isfile)

local function writeSafe(path, content)
    if not FILE_IO then return false end
    return pcall(writefile, path, content)
end

local function readSafe(path)
    if not FILE_IO then return nil end
    local ok, exists = pcall(isfile, path)
    if not ok or not exists then return nil end
    local ok2, content = pcall(readfile, path)
    return ok2 and content or nil
end

local function saveSession(mode, startTime)
    local t = startTime or os.time()
    writeSafe(CONFIG.FILE_SESSION, string.format("%s|%d", mode, t))
    getgenv().AutoAFK_SessionData = {mode = mode, startTime = t}
    log(string.format("Session [%s] disimpan (start=%s)", mode, os.date("%H:%M:%S", t)))
end

local function loadSession()
    local backup = getgenv().AutoAFK_SessionData
    if backup and backup.mode and backup.startTime then
        return backup.mode, backup.startTime, "getgenv"
    end
    local content = readSafe(CONFIG.FILE_SESSION)
    if content and content ~= "" then
        local mode, ts = content:match("^([^|]+)|(%d+)$")
        if mode and ts then return mode, tonumber(ts), "file" end
    end
    return nil
end

local function clearSession()
    writeSafe(CONFIG.FILE_SESSION, "")
    getgenv().AutoAFK_SessionData = nil
end

-- =====================================================
-- Anti-Idle & Heartbeat
-- =====================================================
local lastAntiIdle = 0
local function performAntiIdle()
    if tick() - lastAntiIdle < CONFIG.ANTI_IDLE_THROTTLE then return end
    lastAntiIdle = tick()
    pcall(function() VU:CaptureController(); VU:ClickButton2(Vector2.new(0, 0)) end)
end

player.Idled:Connect(performAntiIdle)
task.spawn(function()
    task.wait(CONFIG.ANTI_IDLE_WARMUP)
    while true do performAntiIdle(); task.wait(CONFIG.ANTI_IDLE_INTERVAL) end
end)

task.spawn(function()
    while true do writeSafe(CONFIG.FILE_HEARTBEAT, tostring(os.time())); task.wait(CONFIG.HEARTBEAT_EVERY) end
end)

-- =====================================================
-- Teleport & Reload
-- =====================================================
local function queueReload()
    if CONFIG.SCRIPT_URL == "" then return end
    local code = string.format('task.wait(3) loadstring(game:HttpGet("%s"))()', CONFIG.SCRIPT_URL)
    pcall(function() if queue_on_teleport then queue_on_teleport(code) end end)
end

local function teleportTo(placeId, label)
    log(string.format("Teleport ke %d (%s)...", placeId, label))
    local ok = pcall(function() TeleportService:Teleport(placeId, player) end)
    if ok then return true end
    return pcall(function() TeleportService:TeleportAsync(placeId, {player}) end)
end

-- =====================================================
-- DETEKTOR UI GAME
-- =====================================================
local function isRewardCollected()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return false, "No PlayerGui" end
    
    local current = pg
    for segment in CONFIG.UI_PATH:gmatch("[^%.]+") do
        current = current:FindFirstChild(segment)
        if not current then return false, "Path not found" end
    end
    
    local txt = current.Text:lower()
    if txt:find("collected") then
        return true, current.Text
    end
    return false, current.Text
end

-- =====================================================
-- UI Builder (Dengan Logika Buffer)
-- =====================================================
local currentUI = nil

local function buildUI(opts)
    opts = opts or {}
    if currentUI then pcall(function() currentUI.destroy() end) end
    
    local parent = gethui and gethui() or player:WaitForChild("PlayerGui")
    local sg = Instance.new("ScreenGui")
    sg.Name = "AutoAFK_UI"
    sg.ResetOnSpawn = false
    sg.DisplayOrder = 2147483647
    sg.IgnoreGuiInset = true
    sg.Parent = parent

    local panel = Instance.new("Frame")
    panel.Size = UDim2.new(0, 320, opts.showTimer and 140 or 52)
    panel.Position = UDim2.new(1, -340, 0, 20)
    panel.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    panel.BackgroundTransparency = 0.1
    panel.Parent = sg
    Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)
    local stroke = Instance.new("UIStroke", panel)
    stroke.Color = Color3.fromRGB(255, 200, 60)

    -- Header
    local header = Instance.new("Frame", panel)
    header.Size = UDim2.new(1, 0, 0, 52)
    header.BackgroundTransparency = 1
    header.Active = true

    local dot = Instance.new("Frame", header)
    dot.Size = UDim2.new(0, 10, 0, 10)
    dot.Position = UDim2.new(0, 16, 0.5, -5)
    dot.BackgroundColor3 = Color3.fromRGB(80, 220, 120)
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local title = Instance.new("TextLabel", header)
    title.Size = UDim2.new(1, -100, 1, 0)
    title.Position = UDim2.new(0, 34, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = "AUTO AFK (v18)"
    title.TextColor3 = Color3.fromRGB(240, 240, 250)
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13

    -- Info Timer
    local infoLabel, subLabel
    if opts.showTimer then
        infoLabel = Instance.new("TextLabel", panel)
        infoLabel.Size = UDim2.new(1, -28, 0, 20)
        infoLabel.Position = UDim2.new(0, 14, 0, 56)
        infoLabel.BackgroundTransparency = 1
        infoLabel.Text = "Memantau UI Game..."
        infoLabel.TextColor3 = Color3.fromRGB(255, 220, 80)
        infoLabel.TextXAlignment = Enum.TextXAlignment.Left
        infoLabel.Font = Enum.Font.GothamBold
        infoLabel.TextSize = 14
        
        subLabel = Instance.new("TextLabel", panel)
        subLabel.Size = UDim2.new(1, -28, 0, 16)
        subLabel.Position = UDim2.new(0, 14, 0, 78)
        subLabel.BackgroundTransparency = 1
        subLabel.Text = "Menunggu 'collected this session'..."
        subLabel.TextColor3 = Color3.fromRGB(160, 160, 180)
        subLabel.TextXAlignment = Enum.TextXAlignment.Left
        subLabel.Font = Enum.Font.Gotham
        subLabel.TextSize = 11
    end

    -- Drag logic
    local dragging, dragStart, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = panel.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - dragStart
            panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)

    -- Fungsi update UI
    local function updateStatus(mainText, subText, isReady, isBuffer)
        if infoLabel then
            infoLabel.Text = mainText
            if isBuffer then
                infoLabel.TextColor3 = Color3.fromRGB(255, 140, 60) -- Oranye untuk mode buffer
                stroke.Color = Color3.fromRGB(255, 140, 60)
                dot.BackgroundColor3 = Color3.fromRGB(255, 140, 60)
            elseif isReady then
                infoLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
                stroke.Color = Color3.fromRGB(80, 220, 120)
                dot.BackgroundColor3 = Color3.fromRGB(80, 220, 120)
            else
                infoLabel.TextColor3 = Color3.fromRGB(255, 220, 80)
                stroke.Color = Color3.fromRGB(255, 200, 60)
                dot.BackgroundColor3 = Color3.fromRGB(255, 200, 60)
            end
            if subLabel then subLabel.Text = subText end
        end
    end

    currentUI = {
        destroy = function() sg:Destroy() end,
        updateStatus = updateStatus
    }
end

-- =====================================================
-- MAIN LOGIC
-- =====================================================
local enabled = readSafe(CONFIG.FILE_ENABLED) ~= "off"
queueReload()

if game.PlaceId == CONFIG.PLACE_LOBBY then
    log("=== LOBBY ===")
    local sessMode = loadSession()
    if sessMode == "afk" then clearSession() end
    
    if CONFIG.UI_ENABLED then buildUI({showTimer = false}) end
    if not enabled then return end
    
    log("Masuk ke AFK Room dalam " .. CONFIG.GRACE_DELAY .. "s")
    task.wait(CONFIG.GRACE_DELAY)
    
    if enabled then
        saveSession("lobby", os.time())
        teleportTo(CONFIG.PLACE_AFK, "masuk AFK")
    end

elseif game.PlaceId == CONFIG.PLACE_AFK then
    log("=== AFK ROOM ===")
    
    -- Load Session
    local sessMode, sessStart = loadSession()
    if sessMode == "lobby" then
        saveSession("afk", os.time())
        sessStart = os.time()
    elseif not sessStart then
        sessStart = os.time()
        saveSession("afk", sessStart)
    end
    
    if CONFIG.UI_ENABLED then buildUI({showTimer = true}) end
    if not enabled then return end

    log("Fase 1: Menunggu UI Game berubah 'collected'...")
    local detectedCollected = false
    local detectionTime = 0
    
    -- =====================================================
    -- FASE 1: Menunggu UI "collected"
    -- =====================================================
    while enabled do
        task.wait(CONFIG.POLL_RATE)
        
        local isCollected, currentText = isRewardCollected()
        
        if isCollected then
            log("✅ Teks UI berubah: " .. currentText)
            detectedCollected = true
            detectionTime = os.time()
            break
        end
        
        local elapsed = os.time() - sessStart
        if elapsed >= CONFIG.FALLBACK_DURATION then
            log("⚠️ Fallback timer tercapai (UI macet). Force exit.")
            detectedCollected = true
            detectionTime = os.time() - CONFIG.SAFE_BUFFER -- Paksa buffer langsung habis
            break
        end
        
        if currentUI and (elapsed % 5 == 0) then
            local sisa = math.max(0, 1800 - elapsed)
            currentUI.updateStatus(
                string.format("Sisa %02d:%02d", math.floor(sisa/60), sisa%60), 
                "Status UI: " .. (currentText or "?"), false, false
            )
        end
    end
    
    -- =====================================================
    -- FASE 2: Safe Buffer (Jeda 2 Menit)
    -- =====================================================
    if detectedCollected and enabled then
        log(string.format("Fase 2: Memulai Safe Buffer (%d detik)...", CONFIG.SAFE_BUFFER))
        
        while enabled do
            task.wait(CONFIG.POLL_RATE)
            
            local bufferElapsed = os.time() - detectionTime
            local bufferRemaining = CONFIG.SAFE_BUFFER - bufferElapsed
            
            if bufferRemaining <= 0 then
                log("✅ Buffer selesai. Waktunya balik ke Lobby!")
                break
            end
            
            -- Update UI saat buffer berjalan
            if currentUI then
                currentUI.updateStatus(
                    string.format("Buffer: %02d:%02d", math.floor(bufferRemaining/60), bufferRemaining%60),
                    "Reward aman. Menunggu jeda...", 
                    false, true -- Parameter isBuffer = true
                )
            end
        end
    end
    
    -- =====================================================
    -- FASE 3: Keluar ke Lobby
    -- =====================================================
    if enabled then
        if currentUI then currentUI.updateStatus("✅ KELUAR", "Pindah ke Lobby...", true, false) end
        task.wait(1) -- Jeda bentar biar UI script terlihat
        clearSession()
        queueReload()
        teleportTo(CONFIG.PLACE_LOBBY, "balik ke Lobby")
    end
    
else
    log("PlaceId tidak dikenal.")
end
