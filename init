-- =====================================================
local function queueReload()
    if CONFIG.SCRIPT_URL == "" then return end
    local code = string.format('task.wait(3) loadstring(game:HttpGet("%s"))()', CONFIG.SCRIPT_URL)
    pcall(function() if queue_on_teleport then queue_on_teleport(code) end end)
    pcall(function() if syn and syn.queue_on_teleport then syn.queue_on_teleport(code) end end)
end

local function teleportTo(placeId, label)
    log(string.format("Teleport ke %d (%s)...", placeId, label))

    local methods = {
        { name = "Teleport", fn = function() TeleportService:Teleport(placeId, player) end },
        { name = "TeleportAsync", fn = function()
            if TeleportService.TeleportAsync then
                TeleportService:TeleportAsync(placeId, {player})
            else
                error("TeleportAsync tidak tersedia")
            end
        end },
        { name = "TeleportToPlaceInstance", fn = function()
            local ok, jobId = pcall(function() return game.JobId end)
            if jobId and jobId ~= "" then
                TeleportService:TeleportToPlaceInstance(placeId, jobId, player)
            else
                error("JobId tidak tersedia")
            end
        end },
    }

    local attempt = 0
    local maxAttempts = #methods * #CONFIG.RETRY_DELAYS

    for _, method in ipairs(methods) do
        for _, delay in ipairs(CONFIG.RETRY_DELAYS) do
            attempt = attempt + 1
            local ok, err = pcall(method.fn)
            log(string.format("  [%d] %s → %s%s",
                attempt, method.name, tostring(ok),
                (not ok and err) and (" (" .. tostring(err) .. ")") or ""))
            if ok then return true end
            if attempt < maxAttempts then
                log(string.format("  Retry dalam %ds...", delay))
                task.wait(delay)
            end
        end
    end

    log("❌ Semua metode teleport gagal.")
    return false
end

-- =====================================================
-- UI Parent + Destroy existing
-- =====================================================
local function destroyExistingUI()
    local pg = player:FindFirstChild("PlayerGui")
    if pg then
        local old = pg:FindFirstChild("AutoAFK_UI")
        if old then pcall(function() old:Destroy() end) end
    end
    if gethui then
        pcall(function()
            local hui = gethui()
            if hui then
                local old = hui:FindFirstChild("AutoAFK_UI")
                if old then old:Destroy() end
            end
        end)
    end
end

local function resolveParent()
    if gethui then
        local ok, hui = pcall(gethui)
        if ok and typeof(hui) == "Instance" then
            return hui, "gethui"
        end
    end
    return player:WaitForChild("PlayerGui"), "PlayerGui"
end

local function ensureParented(sg, targetParent, label)
    if not sg or not sg.Parent then return false end
    if sg.Parent ~= targetParent then
        log(string.format("UI diturunkan ke '%s' → balik ke '%s'",
            sg.Parent.Name, label))
        pcall(function() sg.Parent = targetParent end)
        task.wait(0.1)
        return sg.Parent == targetParent
    end
    return true
end

