--// Game UI detection
local function readRewardUI()
    local playerGui = player:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return false, "PlayerGui belum tersedia" end

    local current = playerGui
    for segment in CONFIG.UI_PATH:gmatch("[^%.]+") do
        current = current:FindFirstChild(segment)
        if not current then return false, "Menunggu UI reward" end
    end

    if not current:IsA("TextLabel") and not current:IsA("TextBox") then
        return false, "Target UI bukan TextLabel/TextBox"
    end

    local value = current.Text
    if type(value) ~= "string" then return false, "Teks UI tidak valid" end
    return value:lower():find("collected") ~= nil, value
end

--// Optional anti-idle: connected only while enabled.
local function stopAntiIdle()
    if Runtime.antiIdleConnection then
        pcall(function() Runtime.antiIdleConnection:Disconnect() end)
        Runtime.antiIdleConnection = nil
    end
end

local function antiIdleAction()
    if not isEnabled() then return end
    local now = os.clock()
    if now - Runtime.lastAntiIdle < CONFIG.ANTI_IDLE_INTERVAL then return end
    Runtime.lastAntiIdle = now

    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new(0, 0))
    end)
end

local function startAntiIdle()
    stopAntiIdle()
    if not isEnabled() then return end

    Runtime.lastAntiIdle = os.clock()
    Runtime.antiIdleConnection = player.Idled:Connect(function()
        if isEnabled() then
            Runtime.lastAntiIdle = 0
            antiIdleAction()
        end
    end)
end

--// Teleport helpers
local function queueReload()
    if not isEnabled() or CONFIG.SCRIPT_URL == "" then return end
    if type(queue_on_teleport) ~= "function" then return end

    local source = string.format(
        'task.wait(3); loadstring(game:HttpGet("%s"))()',
        CONFIG.SCRIPT_URL
    )
    pcall(queue_on_teleport, source)
end

local function cancellableWait(seconds)
    local started = os.clock()
    while os.clock() - started < seconds do
        if not isEnabled() then return false end
        task.wait(0.2)
    end
    return isEnabled()
end

local function staggerWait(maxDelay, label)
    if maxDelay <= 0 then return isEnabled() end
    local delay = player.UserId % (maxDelay + 1)
    if delay <= 0 then return isEnabled() end
    log("Stagger", label, delay .. " detik")
    return cancellableWait(delay)
end

local function teleportTo(placeId, label)
    if not isEnabled() then return false, "disabled" end
    log("Teleport:", label, placeId)

    local methods = {
        function() TeleportService:Teleport(placeId, player) end,
        function()
            TeleportService:TeleportAsync(placeId, { player })
        end,
    }

    for methodIndex, method in ipairs(methods) do
        for attempt, delay in ipairs(CONFIG.RETRY_DELAYS) do
            if not isEnabled() then return false, "disabled" end
            local ok, err = pcall(method)
            if ok then
                log("Teleport request diterima:", methodIndex, attempt)
                return true
            end
            log("Teleport gagal:", tostring(err))
            if not cancellableWait(delay) then
                return false, "disabled"
            end
        end
    end
    return false, "all attempts failed"
end

--// Worker lifecycle
local function stopWorker()
    local thread = Runtime.worker
    Runtime.worker = nil
    if thread then pcall(task.cancel, thread) end

    local heartbeat = Runtime.heartbeatWorker
    Runtime.heartbeatWorker = nil
    if heartbeat then pcall(task.cancel, heartbeat) end

    stopAntiIdle()
end

local function heartbeatLoop()
    while isEnabled() do
        writeFile(FILES.heartbeat, tostring(os.time()))
        for _ = 1, CONFIG.HEARTBEAT_EVERY * 5 do
            if not isEnabled() then return end
            task.wait(0.2)
        end
    end
end

local function addCompletedStats(startedAt)
    local duration = math.max(0, os.time() - startedAt)
    Runtime.stats.sessions += 1
    Runtime.stats.runtime += duration
    Runtime.stats.yen += CONFIG.REWARD_YEN
    saveStats()
    updateStatsLabel(formatStats())
    log("Reward tercatat. Runtime:", duration, "detik")
end

local function runLobby()
    if not isEnabled() then return end
    updateStatus("LOBBY", "Persiapan menuju AFK room", "ready")

    local started = os.clock()
    while os.clock() - started < CONFIG.GRACE_DELAY do
        if not isEnabled() then return end
        updateStatus(
            "LOBBY",
            string.format("Mulai dalam %ds", math.ceil(CONFIG.GRACE_DELAY - (os.clock() - started))),
            "ready"
        )
        task.wait(0.2)
    end

    if not staggerWait(CONFIG.STAGGER_MAX_LOBBY, "masuk AFK") then return end
    if not isEnabled() then return end

    saveSession("lobby", os.time(), false)
    queueReload()
    local ok, reason = teleportTo(CONFIG.PLACE_AFK, "masuk AFK room")
    if not ok and reason ~= "disabled" then
        updateStatus("TELEPORT GAGAL", "Tetap di lobby. Toggle OFF/ON untuk mencoba lagi.", "error")
    end
end

local function runAFK()
    if not isEnabled() then return end

    local session = Runtime.session or loadSession()
    if not session or session.mode ~= "afk" then
        session = {
            mode = "afk",
            startedAt = os.time(),
            rewardClaimed = false,
            detectedAt = nil,
            statsCredited = false,
        }
        saveSession(session.mode, session.startedAt, false, nil, false)
    end

    Runtime.session = session
    local startedAt = session.startedAt
    local rewardClaimed = session.rewardClaimed == true
    local detectedAt = session.detectedAt

    updateStatus("AFK ROOM", "Memantau status reward", "ready")

    local lastUIUpdate = 0

    while isEnabled() and not rewardClaimed do
        local collected, textValue = readRewardUI()
        local elapsed = math.max(0, os.time() - startedAt)

        if collected then
            detectedAt = os.time()
            rewardClaimed = true
            saveSession("afk", startedAt, true, detectedAt, session.statsCredited)
            log("Reward terdeteksi:", textValue)
            break
        end

        if elapsed >= CONFIG.FALLBACK_DURATION then
            detectedAt = os.time() - CONFIG.SAFE_BUFFER
            rewardClaimed = true
            saveSession("afk", startedAt, true, detectedAt, session.statsCredited)
            log("Fallback timer tercapai; lanjut ke safe buffer.")
            break
        end

        if os.clock() - lastUIUpdate >= CONFIG.UI_REFRESH_RATE then
            lastUIUpdate = os.clock()
            local remaining = math.max(0, CONFIG.FALLBACK_DURATION - elapsed)
            updateStatus(
                string.format("AFK %02d:%02d", math.floor(remaining / 60), remaining % 60),
                "UI Game: " .. tostring(textValue),
                "ready"
            )
        end
        task.wait(CONFIG.POLL_RATE)
    end

    if not isEnabled() then return end

    if rewardClaimed then
        local bufferStart = detectedAt or (os.time() - CONFIG.SAFE_BUFFER)
        while isEnabled() do
            local remaining = CONFIG.SAFE_BUFFER - (os.time() - bufferStart)
            if remaining <= 0 then break end
            updateStatus(
                string.format("BUFFER %02d:%02d", math.floor(remaining / 60), remaining % 60),
                "Menunggu jeda keamanan reward",
                "buffer"
            )
            task.wait(1)
        end
    end

    if not isEnabled() then return end

    -- Mark stats only once, then clear the persisted session.
    if rewardClaimed and Runtime.session and Runtime.session.rewardClaimed then
        if not Runtime.session.statsCredited then
            -- Persist the credit marker before updating totals to reduce duplicate credits
            -- if the user toggles OFF immediately after this point.
            saveSession("afk", startedAt, true, detectedAt, true)
            addCompletedStats(startedAt)
        end
        clearSession()
    end

    updateStatus("SELESAI", "Kembali ke lobby", "ready")
    if not cancellableWait(1) then return end
    if not staggerWait(CONFIG.STAGGER_MAX_AFK, "keluar AFK") then return end

    queueReload()
    local ok, reason = teleportTo(CONFIG.PLACE_LOBBY, "kembali ke lobby")
    if not ok and reason ~= "disabled" then
        updateStatus("TELEPORT GAGAL", "Reward tersimpan. Toggle OFF/ON untuk retry.", "error")
    end
end

local function workerMain()
    Runtime.heartbeatWorker = task.spawn(heartbeatLoop)
    startAntiIdle()

    while isEnabled() do
        if game.PlaceId == CONFIG.PLACE_LOBBY then
            runLobby()
            -- Avoid retry loops if teleport is unavailable.
            if isEnabled() then task.wait(3) end
            if game.PlaceId == CONFIG.PLACE_LOBBY then
                updateStatus("LOBBY SIAP", "Menunggu aksi berikutnya", "ready")
                return
            end
        elseif game.PlaceId == CONFIG.PLACE_AFK then
            runAFK()
            return
        else
            updateStatus("PLACE TIDAK DIKENAL", tostring(game.PlaceId), "error")
            return
        end
    end
end

function Runtime.Disable(reason)
    if not Runtime.alive then return end
    if not Runtime.enabled and not Runtime.worker then return end

    -- Flip the flag first. Every worker checks this before doing work.
    saveEnabled(false)
    stopWorker()
    updateStatus("OFF", "Semua aktivitas otomatis dihentikan", "error")
    if Runtime.ui and Runtime.ui.applyToggle then
        Runtime.ui.applyToggle()
    end
    log("OFF:", reason or "manual")
end

function Runtime.Enable(reason)
    if not Runtime.alive or Runtime.enabled then return end

    saveEnabled(true)
    Runtime.session = loadSession()
    if game.PlaceId == CONFIG.PLACE_AFK and Runtime.session and Runtime.session.mode == "lobby" then
        saveSession("afk", os.time(), false)
    end

    if Runtime.ui and Runtime.ui.applyToggle then
        Runtime.ui.applyToggle()
    end

    log("ON:", reason or "manual")
    updateStatus("AKTIF", "Menjalankan worker", "ready")

    stopWorker()
    Runtime.worker = task.spawn(function()
        local ok, err = xpcall(workerMain, debug.traceback)
        Runtime.worker = nil
        if not ok then
            Runtime.lastError = tostring(err)
            log("Worker error:", Runtime.lastError)
            updateStatus("ERROR", Runtime.lastError, "error")
            stopAntiIdle()
        end
    end)
end

function Runtime.Stop(reason)
    if not Runtime.alive then return end
    Runtime.alive = false
    Runtime.enabled = false
    genv.AutoAFK_Enabled = false
    stopWorker()
    destroyUI()
    log("Runtime stopped:", reason or "cleanup")
end

--// Startup
loadStats()
Runtime.enabled = loadEnabled()
genv.AutoAFK_Enabled = Runtime.enabled
Runtime.session = loadSession()

buildUI()
updateStatsLabel(formatStats())

if Runtime.enabled then
    Runtime.Enable("startup")
else
    updateStatus("OFF", "Semua aktivitas otomatis berhenti", "error")
    if Runtime.ui and Runtime.ui.applyToggle then
        Runtime.ui.applyToggle()
    end
    log("Startup dalam kondisi OFF; worker tidak dibuat.")
end

-- Toggle UI visibility-independent hotkey. Only the toggle remains active while OFF.
local keyConnection = UserInputService.InputBegan:Connect(function(input, processed)
    if processed or not Runtime.alive then return end
    if input.KeyCode == CONFIG.KEYBIND then
        if Runtime.enabled then
            Runtime.Disable("hotkey")
        else
            Runtime.Enable("hotkey")
        end
    end
end)
table.insert(Runtime.uiConnections, keyConnection)

log("v22 initialized. Enabled =", Runtime.enabled)
