-- =====================================================
-- MAIN LOGIC
-- =====================================================
loadEnabled()
loadStats()
queueReload()

if game.PlaceId == CONFIG.PLACE_LOBBY then
    log("=== LOBBY ===")
    local sessMode = loadSession()
    if sessMode == "afk" then clearSession() end
    
    if CONFIG.UI_ENABLED then buildUI({showTimer = false}) end
    if not getgenv().AutoAFK_Enabled then return end
    
    log("Masuk ke AFK Room dalam " .. CONFIG.GRACE_DELAY .. "s")
    task.wait(CONFIG.GRACE_DELAY)
    
    if getgenv().AutoAFK_Enabled then
        doStaggerWait(CONFIG.STAGGER_MAX_LOBBY, "Masuk AFK") -- ⭐ FITUR STAGGER
        saveSession("lobby", os.time())
        teleportTo(CONFIG.PLACE_AFK, "masuk AFK")
    end

elseif game.PlaceId == CONFIG.PLACE_AFK then
    log("=== AFK ROOM ===")
    
    local sessMode, sessStart = loadSession()
    if sessMode == "lobby" then
        saveSession("afk", os.time()); sessStart = os.time()
    elseif not sessStart then
        saveSession("afk", os.time()); sessStart = os.time()
    end
    
    if CONFIG.UI_ENABLED then buildUI({showTimer = true}) end
    if not getgenv().AutoAFK_Enabled then return end

    log("Fase 1: Menunggu UI Game berubah 'collected'...")
    local detectedCollected = false
    local detectionTime = 0
    
    -- ================= FASE 1: DETEKSI =================
    while getgenv().AutoAFK_Enabled do
        task.wait(CONFIG.POLL_RATE)
        
        local isCollected, currentText = isRewardCollected()
        if isCollected then
            log("✅ Teks UI berubah: " .. currentText)
            detectedCollected = true
            detectionTime = os.time()
            break
        end
        
        local elapsed = os.time() - sessStart
        if elapsed >= CONFIG.FALLBACK_DURATION then
            log("⚠️ Fallback timer (UI macet). Force exit.")
            detectedCollected = true
            detectionTime = os.time() - CONFIG.SAFE_BUFFER 
            break
        end
        
        if currentUI and (elapsed % 2 == 0) then
            local sisa = math.max(0, 1800 - elapsed)
            currentUI.updateStatus(string.format("Sisa %02d:%02d", math.floor(sisa/60), sisa%60), "UI Game: " .. (currentText or "?"), "normal")
        end
    end
    
    -- ================= FASE 2: BUFFER =================
    if detectedCollected and getgenv().AutoAFK_Enabled then
        log(string.format("Fase 2: Safe Buffer %ds...", CONFIG.SAFE_BUFFER))
        while getgenv().AutoAFK_Enabled do
            task.wait(CONFIG.POLL_RATE)
            local bufferElapsed = os.time() - detectionTime
            local bufferRemaining = CONFIG.SAFE_BUFFER - bufferElapsed
            if bufferRemaining <= 0 then break end
            
            if currentUI then
                currentUI.updateStatus(string.format("Buffer: %02d:%02d", math.floor(bufferRemaining/60), bufferRemaining%60), "Reward aman. Menunggu jeda...", "buffer")
            end
        end
    end
    
    -- ================= FASE 3: EXIT =================
    if getgenv().AutoAFK_Enabled then
        if currentUI then currentUI.updateStatus("✅ KELUAR", "Pindah ke Lobby...", "ready") end
        
        -- Update Stats (Hitung berapa lama sesi ini berjalan)
        local totalSessionTime = os.time() - sessStart
        addStatsSession(400) -- Tambah 1 sesi, +400 Yen
        addStatsRuntime(totalSessionTime) -- Tambah runtime
        
        task.wait(1)
        clearSession()
        queueReload()
        
        doStaggerWait(CONFIG.STAGGER_MAX_AFK, "Keluar AFK") -- ⭐ FITUR STAGGER
        
        local success = teleportTo(CONFIG.PLACE_LOBBY, "balik ke Lobby")
        if not success then
            log("❌ Gagal balik ke Lobby.")
            if CONFIG.UI_ENABLED then
                buildUI({ showTimer = false, showRetry = true })
                currentState.onRetry = function()
                    if teleportTo(CONFIG.PLACE_LOBBY, "manual retry") then clearSession() end
                end
            end
        end
    end
else
    log("PlaceId tidak dikenal.")
end
