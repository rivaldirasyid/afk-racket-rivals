        buildUI({
            showTimer = false,
            lobbyStatus = recovered and recoveryMsg or string.format("Session #%d", getgenv().AutoAFK_Session),
        })
    end

    if not getgenv().AutoAFK_Enabled then
        log("State OFF — idle. Klik toggle / RShift untuk ON.")
        return
    end

    log("Mode: LOBBY → AFK (" .. CONFIG.GRACE_DELAY .. "s grace)")
    getgenv().AutoAFK_Session = getgenv().AutoAFK_Session + 1

    local t0 = tick()
    while (tick() - t0) < CONFIG.GRACE_DELAY do
        task.wait(0.2)
        if not getgenv().AutoAFK_Enabled then
            log("Dibatalkan oleh toggle OFF."); return
        end
    end

    saveSession("lobby", os.time())
    queueReload()

    local ok = teleportTo(CONFIG.PLACE_AFK, "masuk AFK")
    if not ok then
        log("❌ Gagal masuk AFK setelah semua retry.")
        clearSession()
        if CONFIG.UI_ENABLED then
            buildUI({ showRecovery = true })
            currentState.onRetry = function()
                log("Manual retry dipicu")
                if teleportTo(CONFIG.PLACE_AFK, "manual retry") then
                    clearSession()
                end
            end
        end
    end

-- =====================================================
-- MODE: AFK ROOM
-- =====================================================
elseif game.PlaceId == CONFIG.PLACE_AFK then
    log(string.format("Mode: AFK ROOM — durasi %d menit", CONFIG.AFK_DURATION / 60))

    local sessMode, sessStart = loadSession()
    local startTime, elapsed, remaining
    local sessionRecovered = false
    local sessRecoverMsg = nil

    if sessMode == "afk" and sessStart then
        elapsed = os.time() - sessStart
        remaining = CONFIG.AFK_DURATION - elapsed
        startTime = sessStart
        sessionRecovered = true
        sessRecoverMsg = string.format("Recovered: %d menit sudah AFK", math.floor(elapsed / 60))
        log(string.format("♻️ Recovery session AFK: sudah %ds, sisa %ds", elapsed, remaining))
        if remaining <= 0 then
            log("⏰ Waktu AFK sudah lewat saat disconnect. Langsung balik.")
            if CONFIG.UI_ENABLED then
                buildUI({ showTimer = false, lobbyStatus = "Waktu habis saat disconnect — balik" })
            end
            clearSession()
            queueReload()
            teleportTo(CONFIG.PLACE_LOBBY, "balik (recovery)")
            return
        end
    else
        startTime = os.time()
        elapsed = 0
        remaining = CONFIG.AFK_DURATION
        saveSession("afk", startTime)
        log("Session AFK baru disimpan.")
    end

    if CONFIG.UI_ENABLED then
        getgenv().AutoAFK_StartTime = startTime
        buildUI({
            showTimer = true,
            duration = CONFIG.AFK_DURATION,
            startTime = tick() - elapsed,
            destinationLabel = "Lobby",
            recovered = sessionRecovered,
            recoverMsg = sessRecoverMsg,
        })
    end

    if not getgenv().AutoAFK_Enabled then
        log("State OFF — idle di AFK Room.")
        return
    end

    local startTick = tick()

    while true do
        task.wait(0.5)

        local wallElapsed = os.time() - startTime
        if wallElapsed >= CONFIG.AFK_DURATION then
            log("⏰ Waktu AFK habis → balik ke Lobby")
            break
        end

        if not getgenv().AutoAFK_Enabled then
            log("Toggled OFF — batalkan AFK")
            break
        end

        if currentUI and currentUI.update then pcall(currentUI.update) end

        local wallProgress = os.time() - startTime
        if math.abs(wallProgress - (tick() - startTick)) > CONFIG.STUCK_TIMEOUT then
            log("⚠️ Wall clock dan tick tidak sinkron — mungkin lag berat")
        end
    end

    clearSession()
    log("Teleport balik ke Lobby...")
    queueReload()
    local ok = teleportTo(CONFIG.PLACE_LOBBY, "balik ke Lobby")
    if not ok then
        log("❌ Gagal balik ke Lobby.")
        if CONFIG.UI_ENABLED then
            buildUI({ showRecovery = true })
            currentState.onRetry = function()
                log("Manual retry balik ke Lobby")
                teleportTo(CONFIG.PLACE_LOBBY, "manual retry balik")
            end
        end
    end

else
    log("PlaceId tidak dikenal:", game.PlaceId)
    log("Script hanya untuk:", CONFIG.PLACE_LOBBY, "(Lobby) &", CONFIG.PLACE_AFK, "(AFK)")
end
