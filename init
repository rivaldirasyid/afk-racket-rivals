            infoLabel.Text = mainText
            if subLabel then subLabel.Text = subText end
            local color = Color3.fromRGB(255, 220, 80)
            if statusType == "buffer" then color = Color3.fromRGB(255, 140, 60)
            elseif statusType == "ready" then color = Color3.fromRGB(80, 220, 120)
            elseif statusType == "error" then color = Color3.fromRGB(220, 80, 80)
            end
            infoLabel.TextColor3 = color
            stroke.Color = color
            dot.BackgroundColor3 = color
        end
    end

    local function setStats(text)
        statsLabel.Text = text
    end

    currentUI = {
        destroy = function() sg:Destroy() end,
        updateStatus = updateStatus,
        setStats = setStats,
    }
    return currentUI
end

-- =====================================================
-- MAIN LOGIC
-- =====================================================
getgenv().AutoAFK_Running = true
loadEnabled()
loadStats()
queueReload()

if game.PlaceId == CONFIG.PLACE_LOBBY then
    log("=== LOBBY ===")

    -- Cek session lama dari AFK
    local sessMode = loadSession()
    if sessMode == "afk" then
        log("Session 'afk' lama terdeteksi, dibersihkan.")
        clearSession()
    end

    if CONFIG.UI_ENABLED then buildUI({ showTimer = false }) end

    if not getgenv().AutoAFK_Enabled then
        log("AutoAFK OFF. Idle di Lobby.")
        return
    end

    -- Grace period dengan countdown & cancel check
    log("Grace period " .. CONFIG.GRACE_DELAY .. "s...")
    local graceStart = tick()
    while (tick() - graceStart) < CONFIG.GRACE_DELAY do
        task.wait(0.2)
        if not getgenv().AutoAFK_Enabled then
            log("Grace dibatalkan oleh toggle OFF.")
            return
        end
        if currentUI then
            local remain = math.ceil(CONFIG.GRACE_DELAY - (tick() - graceStart))
            currentUI.setStats(string.format("Masuk AFK dalam %ds...", remain))
        end
    end

    -- Stagger delay (bisa dibatalkan)
    if not doStaggerWait(CONFIG.STAGGER_MAX_LOBBY, "Masuk AFK") then
        return
    end

    if not getgenv().AutoAFK_Enabled then return end

    saveSession("lobby", os.time())
    teleportTo(CONFIG.PLACE_AFK, "masuk AFK")

elseif game.PlaceId == CONFIG.PLACE_AFK then
    log("=== AFK ROOM ===")

    -- Load session dengan guard lengkap
    local sessMode, sessStart = loadSession()
    local now = os.time()
    if sessMode == "lobby" then
        saveSession("afk", now)
        sessStart = now
    elseif sessMode ~= "afk" or not sessStart then
        saveSession("afk", now)
        sessStart = now
    elseif sessStart > now then
        log("⚠️ sessStart di masa depan, reset.")
        saveSession("afk", now)
        sessStart = now
    end

    if CONFIG.UI_ENABLED then buildUI({ showTimer = true }) end

    if not getgenv().AutoAFK_Enabled then
        log("AutoAFK OFF. Idle di AFK Room.")
        return
    end

    -- ================= FASE 1: DETEKSI =================
    log("Fase 1: Menunggu 'collected this session'...")
    local rewardReceived = false
    local detectionTime = 0
    local userAborted = false
    local lastUIUpdate = 0

    while true do
        task.wait(CONFIG.POLL_RATE)

        if not getgenv().AutoAFK_Enabled then
            userAborted = true
            break
        end

        local isCollected, currentText = isRewardCollected()
        if isCollected then
            log("✅ Teks UI berubah: " .. currentText)
            rewardReceived = true
            detectionTime = os.time()
            break
        end

        local elapsed = os.time() - sessStart
        if elapsed >= CONFIG.FALLBACK_DURATION then
            log("⚠️ Fallback timer (UI macet). Force exit.")
            rewardReceived = true
            detectionTime = os.time() - CONFIG.SAFE_BUFFER
            break
        end

        -- Update UI tiap 2 detik
        if currentUI and (os.time() - lastUIUpdate) >= 2 then
            lastUIUpdate = os.time()
            local sisa = math.max(0, 1800 - elapsed)
            currentUI.updateStatus(
                string.format("Sisa %02d:%02d", math.floor(sisa / 60), sisa % 60),
                "UI Game: " .. (currentText or "?"),
                "normal"
            )
        end
    end

    -- ================= FASE 2: BUFFER =================
    if rewardReceived and not userAborted then
        log(string.format("Fase 2: Safe Buffer %ds...", CONFIG.SAFE_BUFFER))
        while true do
            task.wait(CONFIG.POLL_RATE)

            if not getgenv().AutoAFK_Enabled then
                userAborted = true
                break
            end

            local bufferElapsed = os.time() - detectionTime
            local bufferRemaining = CONFIG.SAFE_BUFFER - bufferElapsed
            if bufferRemaining <= 0 then break end

            if currentUI then
                currentUI.updateStatus(
                    string.format("Buffer: %02d:%02d",
                        math.floor(bufferRemaining / 60), bufferRemaining % 60),
                    "Reward aman. Menunggu jeda...",
                    "buffer"
                )
            end
        end
    end

    -- ================= STATS (hanya jika reward diterima) =================
    if rewardReceived then
        local sessionSeconds = os.time() - sessStart
        addStatsSession(400, sessionSeconds)
        log(string.format("Stats: +1 sesi, +400 Yen, +%ds runtime", sessionSeconds))
    end

    -- ================= FASE 3: EXIT =================
    clearSession()

    if userAborted then
        -- User toggle OFF: keluar tanpa stagger delay, tanpa stats update UI
        log("User abort -> balik ke Lobby tanpa stagger")
        queueReload()
        local ok = teleportTo(CONFIG.PLACE_LOBBY, "balik (abort)")
        if not ok then
            log("❌ Gagal balik ke Lobby. Coba lagi nanti.")
        end
        return
    end

    -- Normal exit path
    if currentUI then
        currentUI.updateStatus("✅ KELUAR", "Pindah ke Lobby...", "ready")
    end
    task.wait(1)
    queueReload()

    if not doStaggerWait(CONFIG.STAGGER_MAX_AFK, "Keluar AFK") then
        return
    end

    local success = teleportTo(CONFIG.PLACE_LOBBY, "balik ke Lobby")
    if not success then
        log("❌ Gagal balik ke Lobby.")
        if CONFIG.UI_ENABLED then
            buildUI({ showTimer = false, showRetry = true })
            currentState.onRetry = function()
                if teleportTo(CONFIG.PLACE_LOBBY, "manual retry") then
                    clearSession()
                end
            end
        end
    end

else
    log("PlaceId tidak dikenal.")
end
