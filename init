local fileAvailable =
    type(writefile) == "function"
    and type(readfile) == "function"
    and type(isfile) == "function"

local function safeCall(fn, ...)
    if type(fn) ~= "function" then
        return false, "function unavailable"
    end
    return pcall(fn, ...)
end

local function writeFile(path, content)
    if not fileAvailable then return false end
    local ok = pcall(writefile, path, tostring(content))
    return ok
end

local function readFile(path)
    if not fileAvailable then return nil end
    local ok, exists = pcall(isfile, path)
    if not ok or not exists then return nil end
    local readOk, result = pcall(readfile, path)
    if readOk then return result end
    return nil
end

--// Stop a previous copy cleanly before creating this runtime.
local previous = genv.AutoAFK_V22_Runtime
if type(previous) == "table" and type(previous.Stop) == "function" then
    pcall(previous.Stop, "replaced by a new script instance")
end

local Runtime = {
    alive = true,
    enabled = false,
    worker = nil,
    heartbeatWorker = nil,
    antiIdleConnection = nil,
    uiConnections = {},
    ui = nil,
    lastAntiIdle = 0,
    lastHeartbeat = 0,
    session = nil,
    stats = { sessions = 0, runtime = 0, yen = 0 },
    lastError = nil,
}
genv.AutoAFK_V22_Runtime = Runtime

local function log(...)
    local parts = {}
    for i = 1, select("#", ...) do
        parts[#parts + 1] = tostring(select(i, ...))
    end
    local message = table.concat(parts, " ")
    if CONFIG.DEBUG then
        print("[AutoAFK v22] " .. message)
    end

    local line = os.date("[%Y-%m-%d %H:%M:%S] ") .. message .. "\n"
    if fileAvailable then
        local old = readFile(FILES.log) or ""
        if #old > 100000 then old = "[log rotated]\n" end
        writeFile(FILES.log, old .. line)
    end
end

local function loadEnabled()
    local value = readFile(FILES.enabled)
    if value then
        value = value:lower():gsub("%s+", "")
        return value == "on" or value == "true" or value == "1"
    end
    return true
end

local function saveEnabled(value)
    Runtime.enabled = value == true
    genv.AutoAFK_Enabled = Runtime.enabled
    writeFile(FILES.enabled, Runtime.enabled and "on" or "off")
end

local function loadStats()
    local raw = readFile(FILES.stats)
    if not raw then return end
    local sessions, runtime, yen = raw:match("^(%d+)|(%d+)|(%d+)$")
    if sessions then
        Runtime.stats.sessions = tonumber(sessions) or 0
        Runtime.stats.runtime = tonumber(runtime) or 0
        Runtime.stats.yen = tonumber(yen) or 0
    end
end

local function saveStats()
    local s = Runtime.stats
    writeFile(FILES.stats, string.format("%d|%d|%d", s.sessions, s.runtime, s.yen))
end

local function saveSession(mode, startedAt, rewardClaimed, detectedAt, statsCredited)
    Runtime.session = {
        mode = mode,
        startedAt = startedAt or os.time(),
        rewardClaimed = rewardClaimed == true,
        detectedAt = detectedAt,
        statsCredited = statsCredited == true,
    }
    writeFile(FILES.session, string.format(
        "%s|%d|%d|%d|%d",
        Runtime.session.mode,
        Runtime.session.startedAt,
        Runtime.session.rewardClaimed and 1 or 0,
        Runtime.session.detectedAt or 0,
        Runtime.session.statsCredited and 1 or 0
    ))
end

local function loadSession()
    local raw = readFile(FILES.session)
    if not raw then return nil end
    local mode, startedAt, claimed, detectedAt, credited =
        raw:match("^([^|]+)|(%d+)|(%d+)|(%d+)|(%d+)$")
    if not mode or not startedAt then
        -- Backward compatibility with v21/v22 early session format.
        mode, startedAt, claimed = raw:match("^([^|]+)|(%d+)|(%d+)$")
        if not mode or not startedAt then return nil end
        detectedAt, credited = "0", "0"
    end
    return {
        mode = mode,
        startedAt = tonumber(startedAt),
        rewardClaimed = claimed == "1",
        detectedAt = tonumber(detectedAt) > 0 and tonumber(detectedAt) or nil,
        statsCredited = credited == "1",
    }
end

local function clearSession()
    Runtime.session = nil
    writeFile(FILES.session, "")
end

local function isEnabled()
    return Runtime.alive and Runtime.enabled
end

local function updateStatus(mainText, subText, status)
    if not Runtime.ui then return end
    pcall(function()
        Runtime.ui.updateStatus(mainText, subText, status)
    end)
end

local function updateStatsLabel(message)
    if not Runtime.ui then return end
    pcall(function()
        Runtime.ui.setStats(message)
    end)
end

local function formatStats()
    local s = Runtime.stats
    return string.format(
        "Sesi: %d | Runtime: %dh %dm | Est. Yen: %d",
        s.sessions,
        math.floor(s.runtime / 3600),
        math.floor((s.runtime % 3600) / 60),
        s.yen
    )
end

