    if not cancellableWait(1) then return end
    if not staggerWait(CONFIG.STAGGER_MAX_AFK, "keluar AFK") then return end

    queueReload()
    local ok, reason = teleportTo(CONFIG.PLACE_LOBBY, "kembali ke lobby")
    if not ok and reason ~= "disabled" then
        updateStatus("TELEPORT GAGAL", "Reward tersimpan. Toggle OFF/ON untuk retry.", "error")
    end
end

local function workerMain()
    Runtime.heartbeatWorker = task.spawn(heartbeatLoop)
    startAntiIdle()

    while isEnabled() do
        if game.PlaceId == CONFIG.PLACE_LOBBY then
            runLobby()
            -- Avoid retry loops if teleport is unavailable.
            if isEnabled() then task.wait(3) end
            if game.PlaceId == CONFIG.PLACE_LOBBY then
                updateStatus("LOBBY SIAP", "Menunggu aksi berikutnya", "ready")
                return
            end
        elseif game.PlaceId == CONFIG.PLACE_AFK then
            runAFK()
            return
        else
            updateStatus("PLACE TIDAK DIKENAL", tostring(game.PlaceId), "error")
            return
        end
    end
end

function Runtime.Disable(reason)
    if not Runtime.alive then return end
    if not Runtime.enabled and not Runtime.worker then return end

    -- Flip the flag first. Every worker checks this before doing work.
    saveEnabled(false)
    stopWorker()
    updateStatus("OFF", "Semua aktivitas otomatis dihentikan", "error")
    if Runtime.ui and Runtime.ui.applyToggle then
        Runtime.ui.applyToggle()
    end
    log("OFF:", reason or "manual")
end

function Runtime.Enable(reason)
    if not Runtime.alive or Runtime.enabled then return end

    saveEnabled(true)
    Runtime.session = loadSession()
    if game.PlaceId == CONFIG.PLACE_AFK and Runtime.session and Runtime.session.mode == "lobby" then
        saveSession("afk", os.time(), false)
    end

    if Runtime.ui and Runtime.ui.applyToggle then
        Runtime.ui.applyToggle()
    end

    log("ON:", reason or "manual")
    updateStatus("AKTIF", "Menjalankan worker", "ready")

    stopWorker()
    Runtime.worker = task.spawn(function()
        local ok, err = xpcall(workerMain, debug.traceback)
        Runtime.worker = nil
        if not ok then
            Runtime.lastError = tostring(err)
            log("Worker error:", Runtime.lastError)
            updateStatus("ERROR", Runtime.lastError, "error")
            stopAntiIdle()
        end
    end)
end

function Runtime.Stop(reason)
    if not Runtime.alive then return end
    Runtime.alive = false
    Runtime.enabled = false
    genv.AutoAFK_Enabled = false
    stopWorker()
    destroyUI()
    log("Runtime stopped:", reason or "cleanup")
end

--// Startup
loadStats()
Runtime.enabled = loadEnabled()
genv.AutoAFK_Enabled = Runtime.enabled
Runtime.session = loadSession()

buildUI()
updateStatsLabel(formatStats())

if Runtime.enabled then
    Runtime.Enable("startup")
else
    updateStatus("OFF", "Semua aktivitas otomatis berhenti", "error")
    if Runtime.ui and Runtime.ui.applyToggle then
        Runtime.ui.applyToggle()
    end
    log("Startup dalam kondisi OFF; worker tidak dibuat.")
end

-- Toggle UI visibility-independent hotkey. Only the toggle remains active while OFF.
local keyConnection = UserInputService.InputBegan:Connect(function(input, processed)
    if processed or not Runtime.alive then return end
    if input.KeyCode == CONFIG.KEYBIND then
        if Runtime.enabled then
            Runtime.Disable("hotkey")
        else
            Runtime.Enable("hotkey")
        end
    end
end)
table.insert(Runtime.uiConnections, keyConnection)

log("v22 initialized. Enabled =", Runtime.enabled)
